{
  "name": "@arinspunk/atproto-comments",
  "version": "1.1.3",
  "license": "MIT",
  "exports": "./src/index.ts",
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/atproto-comments.css",
      "LICENSE",
      "README.md"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ]
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env --allow-run scripts/build.ts",
    "check": "deno run --allow-read --allow-env npm:typescript/bin/tsc --noEmit",
    "test": "deno test --allow-env src/"
  },
  "imports": {
    "typescript": "npm:typescript@^5.5.0"
  }
}
