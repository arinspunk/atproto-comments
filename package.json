{
  "name": "atproto-comments",
  "version": "1.3.0",
  "description": "Web Component for displaying AT Protocol comments on any website",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "check": "tsc --noEmit",
    "check:versions": "node scripts/check-versions.js",
    "test:browser": "npm run build && npm ci --prefix tests/browser && node tests/browser/run.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./style.css": "./dist/atproto-comments.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "atproto",
    "bluesky",
    "comments",
    "web-component",
    "custom-element"
  ],
  "author": "arinspunk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arinspunk/atproto-comments.git"
  },
  "homepage": "https://github.com/arinspunk/atproto-comments#readme",
  "bugs": {
    "url": "https://github.com/arinspunk/atproto-comments/issues"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "typescript": "^5.9.3"
  }
}
